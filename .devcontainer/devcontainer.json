{
	"name": "Transport data science container",
	// Use pre-built image by default:
	"image": "ghcr.io/itsleeds/tds",
	// Uncomment the build section below and comment out "image" above to rebuild from ../Dockerfile
	// "build": {
	// 	"dockerfile": "../Dockerfile"
	// },
	"customizations": {
		"vscode": {
			"settings": {
				"r.sessionWatcher": true,
				"r.plot.backend": "auto",
				"r.bracketedPaste": true,
				"r.interactive.executionTarget": "terminal"
			},
			"extensions": [
				"REditorSupport.r",
				"Posit.air-vscode",
				"GitHub.copilot-chat",
				"quarto.quarto",
				"ms-python.python",
				"ms-toolsai.jupyter"
			]
		}
	}
}
